{
  "name": "onyx",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "web": "pnpm --filter @onyx/web dev",
    "mobile": "pnpm --filter @onyx/mobile start",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/core/src/database.types.ts",
    "db:lint": "supabase db lint --level warning",
    "db:push": "supabase db push",
    "typecheck": "pnpm -r typecheck",
    "db:test": "supabase test db",
    "db:types:linked": "supabase gen types typescript --linked --schema public > packages/core/src/database.types.ts",
    "db:test:linked": "supabase test db --linked"
  },
  "devDependencies": {
    "supabase": "^2.34.3",
    "typescript": "^5.7.3"
  }
}
