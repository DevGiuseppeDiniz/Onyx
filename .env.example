# ---------------------------------------------------------------------------
# Supabase local (valores fixos que `supabase start` imprime -- nao sao segredo)
# ---------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# apps/web (Next) -- prefixo NEXT_PUBLIC_ para chegar no browser
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# apps/mobile (Expo) -- prefixo EXPO_PUBLIC_ para chegar no bundle
# No device fisico, 127.0.0.1 nao alcanca sua maquina: use o IP da LAN
# (ex. http://192.168.0.10:54321) ou aponte para o projeto cloud.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# NUNCA no cliente. service_role ignora RLS por completo.
# Usar somente em script local, migration ou GitHub Action.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
